<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="LiveStart 鍏ㄦ爤寰湇鍔￠珮骞跺彂鍘嬫祴璁″垝" enabled="true">
      <stringProp name="TestPlan.comments">鐢ㄤ簬鍘嬫祴鍞エ寰湇鍔＄郴缁?LiveStart锛屾兜鐩栫櫥褰曘€佹紨鍑哄垪琛ㄨ仛鍚堛€佸姩鎬?PathToken 鎶㈢エ涓庡苟鍙戞墸鍑忓簱瀛樺満鏅€?</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="UserDefinedVariablesGui" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTO" elementType="Argument">
            <stringProp name="Argument.name">PROTO</stringProp>
            <stringProp name="Argument.value">http</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_PORT" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_PORT</stringProp>
            <stringProp name="Argument.value">8002</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ENGINE_PORT" elementType="Argument">
            <stringProp name="Argument.name">ENGINE_PORT</stringProp>
            <stringProp name="Argument.value">8004</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SMS_CODE" elementType="Argument">
            <stringProp name="Argument.name">SMS_CODE</stringProp>
            <stringProp name="Argument.value">888888</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TG3_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TG3_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(TG3_THREADS,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TG3_RAMP_TIME" elementType="Argument">
            <stringProp name="Argument.name">TG3_RAMP_TIME</stringProp>
            <stringProp name="Argument.value">${__P(TG3_RAMP_TIME,3)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TG3_LOOPS" elementType="Argument">
            <stringProp name="Argument.name">TG3_LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(TG3_LOOPS,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="骞跺彂鐢ㄦ埛鍙傛暟鍖栭厤缃?(users.csv)" enabled="true">
        <stringProp name="delimiter">,</stringProp>
